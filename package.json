{
  "name": "nitrocircus",
  "private": true,
  "workspaces": [
    "apps/*",
    "nightcityverse",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "docker compose up --build",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "dev:clean": "docker compose down -v",
    "agents": "npm run dev --workspace=workers/agent-runner",
    "web": "npm run dev --workspace=apps/web",
    "nightcityverse": "npm run dev --workspace=nightcityverse",
    "miniverse": "npm run dev --workspace=nightcityverse"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
