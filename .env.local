# Configuración Local - NitroCircus Landing Page
# Este archivo contiene variables de entorno para ejecución local del proyecto

# MongoDB
MONGO_USER=nitro
MONGO_PASS=nitro
MONGO_DB=nitrocircus

# URLs de Servicios
# API: http://localhost:3000
# Web: http://localhost:5173 (Vite dev server)
# MongoDB: localhost:27017
# Redis: localhost:6379

# Telegram (opcional para landing page)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# LLM APIs (opcional para landing page)
GROQ_API_KEY=
PM_AGENT_MODEL=llama-3.3-70b-versatile
AGENT_PRIMARY_PROVIDER=claude
ENABLE_PROVIDER_FALLBACK=true
AGENT_FALLBACK_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CONTEXT_LIMIT=25000
OPENAI_MAX_FILES=6
OPENAI_FILE_BYTES_LIMIT=12000

# GitHub (opcional para landing page)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PROJECT_NUMBER=1

# Miniverse (opcional)
MINIVERSE_URL=http://localhost:4321
