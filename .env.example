# MongoDB
MONGO_USER=nitro
MONGO_PASS=nitro
MONGO_DB=nitrocircus

# Telegram
TELEGRAM_BOT_TOKEN=
# Tu user ID de Telegram (usa @userinfobot para obtenerlo)
TELEGRAM_OWNER_ID=

# LLM APIs
# Groq (PM Agent) — obtén tu clave gratis en https://console.groq.com/
GROQ_API_KEY=
# Modelo del PM Agent (default: llama-3.3-70b-versatile)
PM_AGENT_MODEL=llama-3.3-70b-versatile
# Runner de agentes técnicos
# Primario: Claude Code. Fallback opcional: OpenAI cuando Claude quede sin cuota/auth.
AGENT_PRIMARY_PROVIDER=claude
ENABLE_PROVIDER_FALLBACK=true
AGENT_FALLBACK_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CONTEXT_LIMIT=25000
OPENAI_MAX_FILES=6
OPENAI_FILE_BYTES_LIMIT=12000
# OPENAI_BASE_URL=https://api.openai.com/v1  # también acepta endpoints OpenAI-compatible

# GitHub — token necesita scopes: repo, workflow y project
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PROJECT_NUMBER=1

# NightCityVerse (externo) — capa visual (opcional, no crítico)
# Si no se configura, los eventos se descartan silenciosamente
# En producción (Docker), apunta al servicio NightCityVerse desplegado externamente:
# NIGHTCITYVERSE_URL=http://host.docker.internal:4321
# Compatibilidad temporal con configuración antigua:
# MINIVERSE_URL=http://host.docker.internal:4321
# En desarrollo local, comenta la línea o apunta a tu instancia:
# NIGHTCITYVERSE_URL=http://localhost:4321
# Compatibilidad temporal con configuración antigua:
# MINIVERSE_URL=http://localhost:4321

# Integraciones externas opcionales
# Regla: ninguna integración externa debe romper el arranque del sistema si no está configurada.
# Para features en desarrollo, usar parámetros configurables y fallback/mock cuando falten credenciales reales.
# Ejemplo WhatsApp:
# WHATSAPP_API_URL=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_MOCK_ENABLED=true
