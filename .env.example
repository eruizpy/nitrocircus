# MongoDB
MONGO_USER=nitro
MONGO_PASS=nitro
MONGO_DB=nitrocircus

# Telegram
TELEGRAM_BOT_TOKEN=
# Tu user ID de Telegram (usa @userinfobot para obtenerlo)
TELEGRAM_OWNER_ID=

# LLM APIs
# Groq (PM Agent) — obtén tu clave gratis en https://console.groq.com/
GROQ_API_KEY=
# Modelo del PM Agent (default: llama-3.3-70b-versatile)
PM_AGENT_MODEL=llama-3.3-70b-versatile

# GitHub — token necesita scope: repo (o public_repo para repos públicos)
GITHUB_TOKEN=
GITHUB_OWNER=   # tu usuario u organización en GitHub
GITHUB_REPO=    # nombre del repositorio (sin el owner)

# Miniverse — capa visual (opcional, no crítico)
# Si no se configura, los eventos se descartan silenciosamente
# MINIVERSE_URL=https://your-miniverse-endpoint.example.com/events
